# Python bytecode / build artifacts
__pycache__/
*.py[oc]
*.egg-info/
build/
dist/
wheels/

# Virtual environments
.venv/
venv/

# uv
# (uv.lock is intentionally tracked for reproducible installs)

# Environment variables / secrets
.env
.env.*

# demo_repo_git has its own independent git history (used to demo the agent's
# git-branch/commit workflow) — it must stay out of the main repo's tracking,
# otherwise its nested .git would be picked up as a broken gitlink.
demo_repo_git/

# Test / tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Agent run artifacts
transcript-*.json
eval-results*.json
.agent-runs/
*.jsonl

# Reference docs (personal notes, not part of the shipped project)
docs/

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp
